{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "GrpcConfigurations": {
    "ServerUrl": "http://localhost:5001"
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConfigurationService": {
    "Url": "http://localhost:8080"
  },
  "TimerSettings": {
    "IntervalSeconds" : 2
  },
  "DatabaseStartUp": {
    "IntervalSeconds": 2
  },
  "Kafka" : { 
    "Batching": {
      "BatchSize": 2,
      "TimeoutSeconds": 2,
      "Channel": { 
        "BoundedCapacity": 1233
      }
    },
    "Consumer": {
      "Host": "localhost:8001",
      "GroupId": "petya",
      "Topic": "order_processing"
    },
    "Producer": { 
      "BootstrapServers": "localhost:8001",
      "Topic": "order_creation"
    }
  }
}